# Copy to .env and edit. Never commit a real .env.

# "test" enables /reset. Use "dev" or "prod" for anything shared.
HARNESS_ENV=test

# Where the SQLite state lives. Default is ./harness.db in CWD.
HARNESS_DB_PATH=./harness.db

# Policy version bound into authorization decisions at issue time.
HARNESS_POLICY_VERSION=policy-v1

# Initial refund budget in minor units (10000 = $100.00 if minor=cents).
HARNESS_INITIAL_BUDGET_MINOR=10000

# Operator token for /recovery. In HARNESS_ENV=prod this MUST be set to a
# non-default value or Settings.from_env() refuses to start.
RECOVERY_TOKEN=recovery-token-dev-only-not-a-secret

# How stale the audit-chain head may be before Verifier marks
# evidence_current INCONCLUSIVE. Default: 5 minutes.
HARNESS_STALENESS_WINDOW_US=300000000